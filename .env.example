# Build-time Supabase connection — Vite inlines both values into the bundle.
#
# Leave them blank and the app boots into the Setup screen, where a Project URL
# + anon key can be saved for that browser instead (no rebuild needed).
#
# For a Vercel deployment set these two in Project → Settings → Environment
# Variables; build-time values always take precedence over a browser-saved
# pair. See "Deploy to Vercel" in README.md.
#
# Only the anon / publishable PUBLIC key belongs here — a secret key bypasses
# RLS and must never reach a browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
