# Leave both blank to run StudyLab in offline Demo mode (data stored in your browser).
# Fill them in to enable Live mode with Supabase Auth and cloud-synced progress.
# For a Vercel deployment these two must be set in the project's Environment
# Variables instead — VITE_* values are inlined into the bundle at build time.
# See "Deploy to Vercel" in README.md. Only the anon PUBLIC key belongs here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
